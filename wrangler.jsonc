{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  // Upstream also enables observability (logs/traces), an R2 bucket for
  // backups and image uploads, and a daily backup cron. They are left out on
  // purpose so deploying this version needs no new Cloudflare resources and
  // changes no Worker settings. Backups and uploads report "not configured".
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "316894477eef4443b43cb11b6c243de1"
    }
  ],
  "routes": [
    {
      "pattern": "s.bihari.xyz/*",
      "zone_name": "bihari.xyz"
    }
  ]
}
